# Telegram MTProto API Credentials (obtain from https://my.telegram.org)
API_ID=
API_HASH=

# Telegram String Session (leave empty on first run; saved automatically to .session)
SESSION_STRING=

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Telegram Bot Token (https://t.me/BotFather)
BOT_TOKEN=

# Allowed Telegram User ID for bot command management (https://t.me/userinfobot)
ALLOWED_USER_ID=

# Gemini Model
GEMINI_MODEL=gemini-3.6-flash
